{
  "manifest_version": 3,
  "name": "GTA 6 Spoiler Shield",
  "version": "0.2.0",
  "description": "Hide GTA 6 spoiler-related posts, videos, comments and search results until you choose to reveal them.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.facebook.com/*",
    "https://www.reddit.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.tiktok.com/*",
    "https://www.google.com/*",
    "https://google.com/*",
    "https://www.google.com.eg/*",
    "https://google.com.eg/*",
    "https://www.google.co.uk/*",
    "https://google.co.uk/*",
    "https://discord.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GTA 6 Spoiler Shield",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.facebook.com/*",
        "https://www.reddit.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.tiktok.com/*",
        "https://www.google.com/*",
        "https://google.com/*",
        "https://www.google.com.eg/*",
        "https://google.com.eg/*",
        "https://www.google.co.uk/*",
        "https://google.co.uk/*",
        "https://discord.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}